# Copy to .env.local — NEVER commit real values
DEMO_MODE=true           # one-click demo logins + readable completion code; set false for production
DATA_ADAPTER=memory      # memory | prisma (prisma needs DATABASE_URL + `npx prisma generate` + migrate)
NEXT_PUBLIC_APP_URL=https://localent-ai.vercel.app
DATABASE_URL=            # Supabase Postgres pooled connection (runtime)
DIRECT_URL=              # Supabase Postgres direct connection (migrations)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
STRIPE_SECRET_KEY=       # TEST mode key only for demo (sk_test_...)
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
CHECKR_API_KEY=          # background checks (Verified Pro tier) — phase 8+
# Launch config (blueprint v2 section 7 — defaults approved as config, change anytime)
PLATFORM_PRO_COMMISSION_BPS=1000
PLATFORM_CUSTOMER_FEE_BPS=500
AUTO_RELEASE_HOURS=72
MATCHED_PRO_LIMIT=5
LAUNCH_CATEGORIES=plumbing,electrical,handyman
